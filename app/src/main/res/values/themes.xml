<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Reverb" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/native_default_light_background</item>
    </style>

    <style name="Theme.Reverb.Light" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/native_default_light_background</item>
    </style>

    <style name="Theme.Reverb.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/native_default_amoled_background</item>
    </style>

    <style name="Theme.Reverb.QuickTileAction" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Reverb.Splash" parent="Theme.SplashScreen">
        <item name="android:statusBarColor">@color/native_default_amoled_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/reverb_splash_background</item>
        <item name="android:windowLightNavigationBar">@bool/reverb_splash_dark_navigation_icons</item>
        <item name="windowSplashScreenBackground">@color/reverb_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/reverb_splash_foreground</item>
        <item name="windowSplashScreenAnimationDuration">960</item>
        <item name="postSplashScreenTheme">@style/Theme.Reverb</item>
    </style>

</resources>
