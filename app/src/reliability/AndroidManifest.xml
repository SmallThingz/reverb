<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <instrumentation
        android:name="app.smallthingz.reverb.ReliabilityInstrumentation"
        android:targetPackage="${applicationId}"
        android:functionalTest="true" />
    <application
        android:name="${reliabilityApplicationClass}"
        android:label="${reliabilityAppLabel}"
        tools:replace="android:name,android:label">
        <activity
            android:name="app.smallthingz.reverb.MainActivity"
            android:enabled="${reliabilityMainEnabled}" />
        <activity
            android:name="app.smallthingz.reverb.NativeParityActivity"
            android:exported="false"
            android:theme="@style/Theme.Reverb" />
        <provider
            android:name="app.smallthingz.reverb.ReliabilityDocumentsProvider"
            android:authorities="${applicationId}.reliability.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
